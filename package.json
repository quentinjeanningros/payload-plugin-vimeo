{
  "name": "payload-plugin-vimeo",
  "version": "0.1.2",
  "description": "PayloadCMS 3.x plugin for managing Vimeo videos",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "payload": "^3.0.0",
    "@payloadcms/ui": "^3.74.0",
    "react": "^19.0.0"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "vimeo",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinjeanningros/payload-plugin-vimeo.git"
  },
  "dependencies": {
    "tus-js-client": "^4.3.1"
  }
}
